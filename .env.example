# Variables de entorno opcionales para MiniAuth Lab (solo referencia educativa)
# No se requiere crear un archivo .env para ejecutar el laboratorio estándar.
# NUNCA almacenes secretos reales ni reutilices estas claves fuera de localhost.

MINIAUTH_PORT=5000
MINIAUTH_SECRET_KEY=miniauth-lab-insecure-secret-key-do-not-use-in-prod
MINIAUTH_TARGET_URL=http://app:5000
CUCUMBER_FILTER_TAGS=@normal and not @fallo-controlado
